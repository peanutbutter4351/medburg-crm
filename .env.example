# ─────────────────────────────────────────────────────────────────────────────
# Medburg CRM — Environment Variable Template
# File: .env.example
#
# This file IS committed to version control. It contains only placeholder
# values — no real credentials.
#
# On the VPS:
#   cp .env.example .env.prod
#   nano .env.prod        # fill in real values
#   chmod 600 .env.prod
#   chown medburg:medburg .env.prod
#
# On local dev:
#   cp .env.example .env
#   nano .env             # override for local dev (optional, SQLite is default)
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=medburg_crm.settings.production
DJANGO_DEBUG=False

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=REPLACE_WITH_50+_CHAR_RANDOM_KEY

# Comma-separated — add your domain, VPS IP, and any load-balancer hostnames
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_VPS_IP

# ── File system paths ─────────────────────────────────────────────────────────
DJANGO_MEDIA_ROOT=/var/www/medburg_crm/media
DJANGO_LOG_DIR=/var/log/medburg

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=WARNING
DJANGO_APP_LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=medburg_db
POSTGRES_USER=medburg_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_CONN_MAX_AGE=60

# Uncomment if using a managed PostgreSQL with SSL required
# POSTGRES_REQUIRE_SSL=True

# ── SSL / Security ────────────────────────────────────────────────────────────
# Set to False during initial deploy (before Certbot). Flip to True after SSL.
DJANGO_SECURE_SSL_REDIRECT=False

# Uncomment and set after SSL is stable for 30+ days
# DJANGO_HSTS_SECONDS=31536000
