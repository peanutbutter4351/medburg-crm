# ─────────────────────────────────────────────────────────────────────────────
# Medburg CRM — Production Environment Variables
# Target: Ubuntu VPS with Gunicorn + Nginx + PostgreSQL
#
# USAGE:
#   systemd: EnvironmentFile=/path/to/.env.prod   (in [Service] section)
#   manual:  export $(grep -v '^#' .env.prod | xargs)
#
# IMPORTANT: Never commit this file with real credentials to version control.
#            Keep it out of git via .gitignore (*.env, .env*)
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=medburg_crm.settings.production
DJANGO_DEBUG=False

# Generate a new key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=ww9sq@_vnsm0olm-(^w-j9k$wdw49w-*@f4&xyo-ao83^vx@^s

# Comma-separated — include your domain, IP, and any load-balancer hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── File system paths ─────────────────────────────────────────────────────────
# Directory for user-uploaded media files (Nginx serves this directly)
DJANGO_MEDIA_ROOT=/var/www/medburg_crm/media

# Directory for application log files (must be writable by app user)
DJANGO_LOG_DIR=/var/log/medburg

# ── Logging ───────────────────────────────────────────────────────────────────
# Root logger level: DEBUG | INFO | WARNING | ERROR | CRITICAL
DJANGO_LOG_LEVEL=WARNING

# Application (medburg.*) logger level
DJANGO_APP_LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=medburg_db
POSTGRES_USER=medburg_user
POSTGRES_PASSWORD=MCRM_Postgres@2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection pooling per Gunicorn worker (seconds, 0 = disable)
DJANGO_CONN_MAX_AGE=60

# Set to True if your PostgreSQL requires SSL (e.g., managed DB providers)
# POSTGRES_REQUIRE_SSL=False

# ── SSL / Security ────────────────────────────────────────────────────────────
# Set to False during initial VPS setup before Nginx TLS is configured
# DJANGO_SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds — default 1 year (31536000)
# DJANGO_HSTS_SECONDS=31536000